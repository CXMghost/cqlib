"""Typed interfaces for structured fermionic algebra and sparse mappings."""

from typing import (
    Iterable,
    Literal,
    Protocol,
    Sequence,
    TypeAlias,
    final,
    runtime_checkable,
)
from .hamiltonian import Hamiltonian

_Coefficient: TypeAlias = complex | float | int

@final
class FermionicLadder:
    """Immutable ladder, constructed with create or annihilate, not directly."""
    @staticmethod
    def create(mode: int) -> FermionicLadder: ...
    @staticmethod
    def annihilate(mode: int) -> FermionicLadder: ...
    @property
    def mode(self) -> int: ...
    @property
    def kind(self) -> Literal["create", "annihilate"]: ...
    def adjoint(self) -> FermionicLadder: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __hash__(self) -> int: ...
    def __repr__(self) -> str: ...

@final
class FermionicOp:
    """Mutable complex sum of ordered products. B acts first in A * B.

    Identical ordered products merge exactly; no implicit normal ordering or
    numerical truncation occurs. Mode counts are retained for zero and identity.
    """

    __hash__: None  # type: ignore[assignment]
    def __new__(cls, num_modes: int) -> FermionicOp: ...
    @staticmethod
    def identity(num_modes: int) -> FermionicOp: ...
    @staticmethod
    def from_term(
        num_modes: int,
        term: Iterable[FermionicLadder],
        coefficient: _Coefficient = 1.0,
    ) -> FermionicOp: ...
    @staticmethod
    def from_terms(
        num_modes: int,
        terms: Iterable[tuple[Iterable[FermionicLadder], _Coefficient]],
    ) -> FermionicOp: ...
    @staticmethod
    def creation(num_modes: int, mode: int) -> FermionicOp: ...
    @staticmethod
    def annihilation(num_modes: int, mode: int) -> FermionicOp: ...
    @staticmethod
    def number(num_modes: int, mode: int) -> FermionicOp: ...
    @staticmethod
    def total_number(num_modes: int) -> FermionicOp: ...
    @staticmethod
    def excitation_generator(
        num_modes: int, sources: Sequence[int], targets: Sequence[int]
    ) -> FermionicOp:
        """G = i(T - T†); targets in order, source annihilators in reverse order.

        Lists must be nonempty, equally sized, unique and disjoint. Input order
        is preserved, with no implicit sorting or factorial normalization.
        """
        ...
    @property
    def num_modes(self) -> int: ...
    @property
    def num_terms(self) -> int: ...
    @property
    def terms(self) -> list[tuple[tuple[FermionicLadder, ...], complex]]:
        """Independent snapshot in deterministic structural order."""
        ...
    def is_zero(self) -> bool:
        """Whether the stored sum is empty; use equiv to test algebraic zero."""
        ...
    def add_term(
        self, term: Iterable[FermionicLadder], coefficient: _Coefficient = 1.0
    ) -> None:
        """Modify in place; errors leave this object unchanged."""
        ...
    def adjoint(self) -> FermionicOp: ...
    def normal_order(self) -> FermionicOp:
        """Return a new expansion: creators first, ascending modes in each group."""
        ...
    def scaled(self, factor: _Coefficient) -> FermionicOp: ...
    def chop(self, *, atol: float = 0.0) -> None:
        """Remove terms with complex magnitude <= atol, in place."""
        ...
    def equiv(self, other: FermionicOp, *, atol: float = 0.0) -> bool: ...
    def is_hermitian(self, *, atol: float = 0.0) -> bool: ...
    def __add__(self, other: FermionicOp, /) -> FermionicOp: ...
    def __sub__(self, other: FermionicOp, /) -> FermionicOp: ...
    def __mul__(self, other: FermionicOp | _Coefficient, /) -> FermionicOp: ...
    def __rmul__(self, other: _Coefficient, /) -> FermionicOp: ...
    def __neg__(self) -> FermionicOp: ...
    def __eq__(self, other: object, /) -> bool:
        """Structural equality; use equiv for algebraic equivalence."""
        ...
    def copy(self) -> FermionicOp: ...
    def __copy__(self) -> FermionicOp: ...
    def __deepcopy__(self, memo: dict[int, object]) -> FermionicOp: ...
    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...

@runtime_checkable
class FermionToQubitMapper(Protocol):
    def map_operator(self, op: FermionicOp) -> Hamiltonian: ...
    def num_qubits(self, num_modes: int) -> int: ...

@runtime_checkable
class OccupationStateMapper(Protocol):
    def map_occupation(self, occupation: Sequence[int]) -> list[bool]: ...

@final
class JordanWignerMapper:
    """Mode p maps to qubit p; Z chain uses modes below p. Qubit 0 is LSB."""
    def __init__(self) -> None: ...
    def map_operator(self, op: FermionicOp) -> Hamiltonian: ...
    def num_qubits(self, num_modes: int) -> int: ...
    def map_occupation(self, occupation: Sequence[int]) -> list[bool]: ...
    def __repr__(self) -> str: ...

__all__ = [
    "FermionicLadder",
    "FermionicOp",
    "FermionToQubitMapper",
    "OccupationStateMapper",
    "JordanWignerMapper",
]
